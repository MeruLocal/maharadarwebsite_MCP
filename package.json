{
  "name": "maharadar-mcp",
  "version": "0.1.0",
  "description": "Public, read-only MCP server for maharadar.com: free SEO tools, platform features, plan limits and SEO checklist, with canonical URLs.",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "sync:content": "node --experimental-strip-types scripts/sync-content.mts",
    "check:versions": "node scripts/check-versions.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
